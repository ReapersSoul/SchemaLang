// Test schema for debugging

enum Status {
	Active,
	Inactive,
	Pending
}

struct Character {
	string: name: required: description("Character name");
	int32: level: required: description("Character level");
	Status: status: required: description("Character status");
	bool: is_player: optional: description("Is this a player character");
}

struct Quest {
	string: title: required: description("Quest title");
	string: description: required: description("Quest description");
	int64: character_id: optional: reference(Character.id): description("Assigned character");
}
