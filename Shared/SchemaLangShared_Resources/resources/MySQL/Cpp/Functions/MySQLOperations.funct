bool {{identifier}}Schema::MySQLSelect(MySQLDB* db)
{
    if (db == nullptr) {
        throw std::runtime_error("{{identifier}}Schema::MySQLSelect() - MySQLDB instance is null. Cannot select {{identifier}}Schema with ID: " + std::to_string(this->getId()) + ". Provide a valid MySQLDB connection.");
    }
    db->select{{identifier}}ById(this->getId());
}

bool {{identifier}}Schema::MySQLInsertUpdate(MySQLDB* db)
{
    if (db == nullptr) {
        throw std::runtime_error("{{identifier}}Schema::MySQLInsertUpdate() - MySQLDB instance is null. Cannot insert or update {{identifier}}Schema with ID: " + std::to_string(this->getId()) + ". Provide a valid MySQLDB connection.");
    }
    db->insertOrUpdate{{identifier}}(shared_from_this());
}

bool {{identifier}}Schema::MySQLDelete(MySQLDB* db)
{
    if (db == nullptr) {
        throw std::runtime_error("{{identifier}}Schema::MySQLDelete() - MySQLDB instance is null. Cannot delete {{identifier}}Schema with ID: " + std::to_string(this->getId()) + ". Provide a valid MySQLDB connection.");
    }
    db->delete{{identifier}}ById(this->getId());
}

const mysqlx::abi2::r0::Row {{identifier}}Schema::toMySQLRow() const
{
    mysqlx::abi2::r0::Row row;
{% set column_index = 0 %}
{% for mv in member_variables %}
{% if not (mv.type.is_array or mv.type.is_struct or mv.type.is_enum) %}
    row.set({{column_index}}, this->{{mv.identifier}}{% if not mv.required %}.value_or({{mv.type.estimated}}{}){% endif %});
{% set column_index = column_index + 1 %}
{% endif %}
{% endfor %}
    return row;
}

