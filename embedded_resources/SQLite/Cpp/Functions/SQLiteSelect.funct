void {{identifier}}Schema::SQLiteSelect(SQLiteDB* db) {
    const char* sql = R"(
        SELECT 
    )";

    sqlite3_stmt* stmt;
    if (sqlite3_prepare_v2(db->getDB(), sql, -1, &stmt, nullptr) != SQLITE_OK) {
        throw std::runtime_error("Failed to prepare statement: " + std::string(sqlite3_errmsg(db->getDB())));
    }

    while (sqlite3_step(stmt) == SQLITE_ROW) {

    }

    sqlite3_finalize(stmt);
}
