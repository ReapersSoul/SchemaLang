std::vector<std::shared_ptr<{{identifier}}Schema>> {{identifier}}Schema::SQLiteSelectAll(sqlite3* db)
{
    std::vector<std::shared_ptr<{{identifier}}Schema>> results;
    std::string sql = "SELECT {% for mv in member_variables %}{% if not (mv.type.is_array or mv.type.is_struct or mv.type.is_enum) %}{{mv.identifier}}{% if not loop.is_last %}, {% endif %}{% endif %}{% endfor %} FROM {{identifier}}";
    
    sqlite3_stmt *stmt;
    int rc = sqlite3_prepare_v2(db, sql.c_str(), -1, &stmt, NULL);
    if(rc != SQLITE_OK) {
        std::cerr << "SQLite prepare error: " << sqlite3_errmsg(db) << std::endl;
        return results;
    }
    
    while(sqlite3_step(stmt) == SQLITE_ROW) {
        std::shared_ptr<{{identifier}}Schema> result = std::make_shared<{{identifier}}Schema>();
{% set column_index = 0 %}
{% for mv in member_variables %}
{% if not (mv.type.is_array or mv.type.is_struct or mv.type.is_enum) %}
        // Column {{column_index}}: {{mv.identifier}}
    {% if mv.type.is_integer %}
        result->set{{mv.identifierCamel}}(sqlite3_column_int(stmt, {{column_index}}));
    {% endif %}
    {% if mv.type.is_real %}
        result->set{{mv.identifierCamel}}(sqlite3_column_double(stmt, {{column_index}}));
    {% endif %}
    {% if mv.type.is_string %}
        const char* {{mv.identifier}}_str = reinterpret_cast<const char*>(sqlite3_column_text(stmt, {{column_index}}));
        if({{mv.identifier}}_str) result->set{{mv.identifierCamel}}(std::string({{mv.identifier}}_str));
    {% endif %}
    {% if mv.type.is_bool %}
        result->set{{mv.identifierCamel}}(sqlite3_column_int(stmt, {{column_index}}) != 0);
    {% endif %}
    {% if not (mv.type.is_integer or mv.type.is_real or mv.type.is_string or mv.type.is_bool) %}
        const char* {{mv.identifier}}_str = reinterpret_cast<const char*>(sqlite3_column_text(stmt, {{column_index}}));
        if({{mv.identifier}}_str) {
            // Handle custom type conversion here
            // result->set{{mv.identifierCamel}}(convert_from_string({{mv.identifier}}_str));
        }
    {% endif %}
{% set column_index = column_index + 1 %}
{% endif %}
{% endfor %}
        results.push_back(result);
    }
    
    sqlite3_finalize(stmt);
    return results;
}

std::vector<std::shared_ptr<{{identifier}}Schema>> {{identifier}}Schema::SQLiteSelectAll()
{
    if(db == nullptr) {
        std::cerr << "Database not set! Call SQLiteSetDatabase first." << std::endl;
        return std::vector<std::shared_ptr<{{identifier}}Schema>>();
    }
    return SQLiteSelectAll(db);
}

