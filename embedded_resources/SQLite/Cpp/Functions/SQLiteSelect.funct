    std::string sql = "SELECT {% for mv2 in member_variables %}{% if not (mv2.type.is_array or mv2.type.is_struct or mv2.type.is_enum) %}{{mv2.identifier}}{% if not loop.is_last %}, {% endif %}{% endif %}{% endfor %} FROM {{identifier}} WHERE {{mv.identifier}} = ?";
    
    sqlite3_stmt *stmt;
    int rc = sqlite3_prepare_v2(db, sql.c_str(), -1, &stmt, NULL);
