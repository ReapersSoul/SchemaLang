{% if header %}
bool SQLiteInsert();
static bool SQLiteInsert(sqlite3* db{% for mv in member_variables %}{% if not (mv.type.is_array or mv.type.is_struct or mv.type.is_enum) %}, {{mv.type.estimated}} {{mv.identifier}}{% endif %}{% endfor %});
{% else %}
bool {{identifier}}Schema::SQLiteInsert()
{
    if(db == nullptr) {
        std::cerr << "Database not set! Call SQLiteSetDatabase first." << std::endl;
        return false;
    }
    return SQLiteInsert(db{% for mv in member_variables %}{% if not (mv.type.is_array or mv.type.is_struct or mv.type.is_enum) %}, this->{{mv.identifier}}{% if mv.required %}{% else %}.value_or({{mv.type.estimated}}{}){% endif %}{% endif %}{% endfor %});
}

bool {{identifier}}Schema::SQLiteInsert(sqlite3* db{% for mv in member_variables %}{% if not (mv.type.is_array or mv.type.is_struct or mv.type.is_enum) %}, {{mv.type.estimated}} {{mv.identifier}}{% endif %}{% endfor %})
{
    std::string sql = "INSERT INTO {{identifier}} ({% for mv in member_variables %}{% if not (mv.type.is_array or mv.type.is_struct or mv.type.is_enum) %}{{mv.identifier}}{% if not loop.is_last %}, {% endif %}{% endif %}{% endfor %}) VALUES ({% for mv in member_variables %}{% if not (mv.type.is_array or mv.type.is_struct or mv.type.is_enum) %}?{% if not loop.is_last %}, {% endif %}{% endif %}{% endfor %})";
    
    sqlite3_stmt *stmt;
    int rc = sqlite3_prepare_v2(db, sql.c_str(), -1, &stmt, NULL);
    if(rc != SQLITE_OK) {
        std::cerr << "SQLite prepare error: " << sqlite3_errmsg(db) << std::endl;
        return false;
    }
    
{% set bind_index = 1 %}
{% for mv in member_variables %}
{% if not (mv.type.is_array or mv.type.is_struct or mv.type.is_enum) %}
    // Bind parameter {{bind_index}}: {{mv.identifier}}
    {% if mv.type.is_integer %}
    sqlite3_bind_int(stmt, {{bind_index}}, {{mv.identifier}});
    {% endif %}
    {% if mv.type.is_real %}
    sqlite3_bind_double(stmt, {{bind_index}}, {{mv.identifier}});
    {% endif %}
    {% if mv.type.is_string %}
    sqlite3_bind_text(stmt, {{bind_index}}, {{mv.identifier}}.c_str(), -1, SQLITE_STATIC);
    {% endif %}
    {% if mv.type.is_bool %}
    sqlite3_bind_int(stmt, {{bind_index}}, {{mv.identifier}} ? 1 : 0);
    {% endif %}
    {% if not (mv.type.is_integer or mv.type.is_real or mv.type.is_string or mv.type.is_bool) %}
    sqlite3_bind_text(stmt, {{bind_index}}, std::to_string({{mv.identifier}}).c_str(), -1, SQLITE_STATIC);
    {% endif %}
{% set bind_index = bind_index + 1 %}
{% endif %}
{% endfor %}
    
    rc = sqlite3_step(stmt);
    sqlite3_finalize(stmt);
    
    if(rc != SQLITE_DONE) {
        std::cerr << "SQLite insert error: " << sqlite3_errmsg(db) << std::endl;
        return false;
    }
    
    return true;
}
{% endif %}