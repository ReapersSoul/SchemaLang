{% if header %}
static bool SQLiteCreateTable(sqlite3* db);
static bool SQLiteCreateTable();
static std::string getSQLiteCreateTableStatement();
{% else %}
bool {{identifier}}Schema::SQLiteCreateTable(sqlite3* db)
{
    char *zErrMsg = 0;
    int rc = sqlite3_exec(db, getSQLiteCreateTableStatement().c_str(), NULL, 0, &zErrMsg);
    if(rc != SQLITE_OK) {
        std::cout << "SQL error: " << zErrMsg << std::endl;
        sqlite3_free(zErrMsg);
        return false;
    }
    return true;
}

bool {{identifier}}Schema::SQLiteCreateTable()
{
    if(db == nullptr) {
        std::cerr << "Database not set! Call SQLiteSetDatabase first." << std::endl;
        return false;
    }
    return SQLiteCreateTable(db);
}

std::string {{identifier}}Schema::getSQLiteCreateTableStatement()
{
    return "CREATE TABLE IF NOT EXISTS {{identifier}} ("
{% for mv in member_variables %}
           "{{mv.identifier}} {% if mv.type.is_integer %}INTEGER{% else %}{% if mv.type.is_real %}REAL{% else %}{% if mv.type.is_string %}TEXT{% else %}{% if mv.type.is_bool %}INTEGER{% else %}TEXT{% endif %}{% endif %}{% endif %}{% endif %}{% if mv.primary_key %} PRIMARY KEY{% endif %}{% if mv.auto_increment %} AUTOINCREMENT{% endif %}{% if mv.required %} NOT NULL{% endif %}{% if not loop.is_last %}, {% endif %}"
{% endfor %}
           ");";
}
{% endif %}
