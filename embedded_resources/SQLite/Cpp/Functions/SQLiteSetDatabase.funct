{% if header %}
static bool SQLiteSetDatabase(sqlite3* db);
static sqlite3* SQLiteGetDatabase();
{% else %}
bool {{identifier}}Schema::SQLiteSetDatabase(sqlite3* db)
{
    if(db == nullptr) {
        std::cerr << "Database pointer is null!" << std::endl;
        return false;
    }
    {{identifier}}Schema::db = db;
    if(!SQLiteCreateTable(db)) {
        std::cerr << "Failed to create table for {{identifier}} in SQLite database." << std::endl;
        return false;
    }
    std::cout << "Database set for {{identifier}} schema." << std::endl;
    return true;
}

sqlite3* {{identifier}}Schema::SQLiteGetDatabase()
{
    return {{identifier}}Schema::db;
}
{% endif %}