{% if header %}

template<typename BasicJsonType>
friend void to_json(BasicJsonType& j, const {{identifier}}Schema& {{identifier}}) {
{% for mv in member_variables %}
{% if not (mv.type.is_array or mv.type.is_struct or mv.type.is_enum) %}
    j["{{mv.identifier}}"] = {{identifier}}.{{mv.identifier}}{% if mv.required %}{% else %}.value_or({{format_default(mv.type,"")}}){% endif %};
{% endif %}
{% endfor %}
}

template<typename BasicJsonType>
friend void from_json(const BasicJsonType& j, {{identifier}}Schema& {{identifier}}) {
{% for mv in member_variables %}
{% if not (mv.type.is_array or mv.type.is_struct or mv.type.is_enum) %}
    {{identifier}}.{{mv.identifier}} = j.value("{{mv.identifier}}", {% if mv.required %}{{format_default(mv.type,"")}}{% else %}std::nullopt{% endif %});
{% endif %}
{% endfor %}
}

static void default_value({{identifier}}Schema &obj){
{% for mv in member_variables %}
{% if not (mv.type.is_array or mv.type.is_struct or mv.type.is_enum) %}
    obj.set{{mv.identifierCamel}}({{format_default(mv.type, "")}});
{% endif %}
{% endfor %}
}

SCHEMA_DEFINE({{identifier}}Schema,
{% for mv in member_variables %}
{% if not (mv.type.is_array or mv.type.is_struct or mv.type.is_enum) %}
SCHEMA_FIELD({{mv.identifier}}, schema::desc("{{mv.description}}"){% if not mv.required %} | schema::optional(){% endif %}){% if not loop.is_last %},{% endif %}
{% endif %}
{% endfor %})

{% else %}
{% endif %}